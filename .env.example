# ---------------------------------------------------------------
# Wrap Station — environment variables
# Copy this file to .env.local and fill in real values.
# ---------------------------------------------------------------

# Resend (https://resend.com) — used by /api/quote to email leads
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Where lead emails are delivered. Defaults to site.email if unset.
QUOTE_TO_EMAIL=info@wrapstationsocal.com

# Verified sender (must be a domain verified in your Resend dashboard).
QUOTE_FROM_EMAIL="Wrap Station <quotes@wrapstationsocal.com>"

# Cal.com (https://cal.com) — public booking handle, e.g. "wrapstationsocal/quote"
NEXT_PUBLIC_CAL_LINK=wrapstationsocal/quote
